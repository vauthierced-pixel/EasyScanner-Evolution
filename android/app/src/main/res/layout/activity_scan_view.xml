<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/evo_background">

    <Button
        android:id="@+id/daoExport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dao_export_button"
        android:layout_margin="10dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/cloudFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">

        <com.rawmechatronics.easyscanner.CloudView
            android:id="@+id/cloud"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/cloudInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_evo_hud"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:textColor="@color/evo_text"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/photosTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/evo_muted"
        android:textSize="13sp" />

    <GridView
        android:id="@+id/photos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:columnWidth="104dp"
        android:horizontalSpacing="3dp"
        android:numColumns="auto_fit"
        android:padding="3dp"
        android:stretchMode="columnWidth"
        android:verticalSpacing="3dp" />
</LinearLayout>
