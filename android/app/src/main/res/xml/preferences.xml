<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/pref_group_interface">
        <SwitchPreferenceCompat
            android:key="expert_mode"
            android:title="@string/pref_mode_expert"
            android:summary="@string/pref_mode_expert_desc"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_group_performance">
        <ListPreference
            android:key="target_fps"
            android:title="@string/pref_target_fps"
            android:defaultValue="30"
            android:entries="@array/fps_labels"
            android:entryValues="@array/fps_values"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:key="auto_resolution"
            android:title="@string/pref_auto_resolution"
            android:summary="@string/pref_auto_resolution_desc"
            android:defaultValue="true" />
        <ListPreference
            android:key="max_long_side"
            android:title="@string/pref_resolution_max"
            android:summary="@string/pref_resolution_max_desc"
            android:defaultValue="1920"
            android:entries="@array/long_side_labels"
            android:entryValues="@array/long_side_values" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_group_camera">
        <ListPreference
            android:key="camera_id"
            android:title="@string/pref_camera_back"
            app:useSimpleSummaryProvider="true" />
        <Preference
            android:key="camera_diagnostic"
            android:title="@string/camera_diag_title"
            android:summary="@string/camera_diag_summary" />
        <SwitchPreferenceCompat
            android:key="manual_focus"
            android:title="@string/pref_manual_focus"
            android:summary="@string/pref_manual_focus_desc"
            android:defaultValue="false" />
        <SeekBarPreference
            android:key="focus_tenths"
            android:title="@string/pref_focus_diopters"
            android:dependency="manual_focus"
            android:defaultValue="30"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true" />
        <SwitchPreferenceCompat
            android:key="manual_exposure"
            android:title="@string/pref_manual_exposure"
            android:summary="@string/pref_manual_exposure_desc"
            android:defaultValue="false" />
        <SeekBarPreference
            android:key="exposure_us"
            android:title="@string/pref_exposure_us"
            android:dependency="manual_exposure"
            android:defaultValue="8000"
            android:max="33000"
            app:min="100"
            app:seekBarIncrement="100"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="iso"
            android:title="@string/pref_iso"
            android:dependency="manual_exposure"
            android:defaultValue="400"
            android:max="3200"
            app:min="50"
            app:seekBarIncrement="50"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="exposure_comp"
            android:title="@string/pref_exposure_comp"
            android:defaultValue="0"
            android:max="12"
            app:min="-12"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_group_board">
        <EditTextPreference
            android:key="board_squares_x"
            android:title="@string/pref_board_squares_x"
            android:defaultValue="8"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="board_squares_y"
            android:title="@string/pref_board_squares_y"
            android:defaultValue="8"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="board_square_mm"
            android:title="@string/pref_board_square_mm"
            android:defaultValue="45.0"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="board_marker_mm"
            android:title="@string/pref_board_marker_mm"
            android:defaultValue="33.3"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="board_dict"
            android:title="@string/pref_board_dict"
            android:defaultValue="5"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_group_laser">
        <SwitchPreferenceCompat
            android:key="laser_enabled"
            android:title="@string/pref_laser_enabled"
            android:defaultValue="true" />
        <ListPreference
            android:key="laser_color"
            android:title="@string/pref_laser_color"
            android:defaultValue="red"
            android:entries="@array/laser_color_labels"
            android:entryValues="@array/laser_color_values"
            app:useSimpleSummaryProvider="true" />
        <SeekBarPreference
            android:key="laser_thresh"
            android:title="@string/pref_laser_threshold"
            android:defaultValue="12"
            android:max="80"
            app:min="1"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="laser_min_sat"
            android:title="@string/pref_laser_saturation"
            android:defaultValue="40"
            android:max="200"
            app:min="0"
            app:showSeekBarValue="true" />
        <SwitchPreferenceCompat
            android:key="laser_without_board"
            android:title="@string/pref_laser_no_board"
            android:summary="@string/pref_laser_no_board_desc"
            android:defaultValue="true" />
        <EditTextPreference
            android:key="volume_height_mm"
            android:title="@string/pref_laser_volume_height"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="volume_margin_mm"
            android:title="@string/pref_laser_volume_margin"
            android:defaultValue="20"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_group_photos">
        <SwitchPreferenceCompat
            android:key="photos_with_scan"
            android:title="@string/pref_photos_scan"
            android:summary="@string/pref_photos_scan_desc"
            android:defaultValue="true" />
        <ListPreference
            android:key="photo_trigger"
            android:title="@string/pref_photos_trigger"
            android:defaultValue="both"
            android:entries="@array/photo_trigger_labels"
            android:entryValues="@array/photo_trigger_values"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="photo_interval_s"
            android:title="@string/pref_photos_interval"
            android:defaultValue="5"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="photo_move_mm"
            android:title="@string/pref_photos_move"
            android:defaultValue="50"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="photo_turn_deg"
            android:title="@string/pref_photos_turn"
            android:defaultValue="10"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="photo_max_speed"
            android:title="@string/pref_photos_max_speed"
            android:defaultValue="40"
            app:useSimpleSummaryProvider="true" />
        <EditTextPreference
            android:key="photo_max_turn"
            android:title="@string/pref_photos_max_turn"
            android:defaultValue="8"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_group_calibration">
        <SeekBarPreference
            android:key="calib_views"
            android:title="@string/pref_calib_views"
            android:defaultValue="64"
            android:max="128"
            app:min="8"
            app:showSeekBarValue="true" />
        <SeekBarPreference
            android:key="plane_views"
            android:title="@string/pref_laser_planes"
            android:defaultValue="10"
            android:max="32"
            app:min="3"
            app:showSeekBarValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_group_detection">
        <SwitchPreferenceCompat
            android:key="aruco3"
            android:title="@string/pref_aruco3"
            android:summary="@string/pref_aruco3_desc"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="roi_tracking"
            android:title="@string/pref_roi_tracking"
            android:defaultValue="true" />
        <SwitchPreferenceCompat android:key="draw_grid" android:title="@string/pref_draw_grid" android:defaultValue="true" />
        <SwitchPreferenceCompat android:key="draw_axes" android:title="@string/pref_draw_axes" android:defaultValue="true" />
        <SwitchPreferenceCompat android:key="draw_corners" android:title="@string/pref_draw_corners" android:defaultValue="true" />
        <SwitchPreferenceCompat android:key="draw_volume" android:title="@string/pref_draw_volume" android:defaultValue="true" />
        <SwitchPreferenceCompat android:key="draw_cloud" android:title="@string/pref_draw_cloud" android:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
